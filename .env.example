# ---- LLM provider 金鑰（至少設定一個；providers.py 依序 fallback）----
# 一律用環境變數，切勿寫進程式或提交到 git
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
GLM_API_KEY=
GOOGLE_API_KEY=

# ---- 掃描後端選擇 ----
# argus-agent＝自家 LLM 多代理引擎（預設）；strix＝改用 usestrix/strix CLI（只做資安滲透）。
# 兩者對外都講同一條 POST /scan 契約。
AGENT_BACKEND=argus-agent

# ---- Strix backend（AGENT_BACKEND=strix 時才用）----
# 需在 host 安裝 strix 並讓 Docker 可用；strix 另讀自己的 STRIX_LLM／LLM_API_KEY／LLM_API_BASE
# （或改用 `strix auth login`）。本服務只負責叫起 strix 並解析其 strix_runs 輸出。
STRIX_BIN=strix
STRIX_TIMEOUT=3600
# 額外傳給 strix 的參數（空白分隔）
STRIX_EXTRA_ARGS=
STRIX_LLM=
LLM_API_KEY=
LLM_API_BASE=

# ---- 服務設定 ----
DEBUG=false
# agent 階段時間／成本的主要旋鈕（每位專家/recon/UX session 的步數上限）
ARGUS_AGENT_SPECIALIST_MAX_STEPS=30
ARGUS_AGENT_MAX_SPECIALIST_DISPATCH=6
ARGUS_AGENT_MAX_STEPS=20
ARGUS_AGENT_MAX_TOKENS=60000
ARGUS_AGENT_UX_MAX_TOKENS=120000
ARGUS_SCANNER_USER_AGENT=ArgusAgent/1.0 (+https://github.com/)
# 掃描器出口 IP（逗號分隔）：WAF/錯誤頁回顯自身 IP 時不誤判成內網外洩
ARGUS_SCANNER_EGRESS_IPS=
# 受控靶機測試才開（且需 DEBUG=true）：放行私網/localhost 目標
ARGUS_ALLOW_PRIVATE_TARGETS=false
# SQLite 暫存位置與截圖暫存目錄
ARGUS_DB_PATH=db.sqlite3
ARGUS_MEDIA_ROOT=media
