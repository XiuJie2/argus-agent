# Strix 版 argus-agent 環境變數範例（複製成 .env.strix 並填值）

# ---- 後端選擇 ----
AGENT_BACKEND=strix

# ---- Strix 自身的 LLM（擇一設定；或改用 `strix auth login`）----
# 例：openrouter/z-ai/glm-5.3、vercel_ai_gateway/zai/glm-5.3
STRIX_LLM=
LLM_API_KEY=
# 自架 LLM（Ollama/LMStudio）才需要
# LLM_API_BASE=

# ---- Strix backend 參數 ----
STRIX_BIN=strix
STRIX_TIMEOUT=3600
# 額外傳給 strix 的參數（空白分隔），例如限制掃描範圍
STRIX_EXTRA_ARGS=

# ---- 服務設定 ----
DEBUG=false
# 需為 true，/scan 才會實際執行（與 Argus 端的 ARGUS_AGENT_ENABLED 無關，這是服務自身的閘）
ARGUS_AGENT_ENABLED=true
# 僅本機受控靶機測試才開（需 DEBUG=true）：放行私網/localhost 目標
ARGUS_ALLOW_PRIVATE_TARGETS=false
