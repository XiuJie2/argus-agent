# /etc/argus-agent.env —— argus-agent 服務環境（chmod 600；勿提交真金鑰）
DJANGO_SETTINGS_MODULE=svc.settings
DJANGO_SECRET_KEY=change-me
DEBUG=false
ARGUS_AGENT_ENABLED=true

# 引擎：argus-agent＝自家多代理（預設）；strix＝改用 usestrix/strix CLI
AGENT_BACKEND=argus-agent

# 服務 Bearer 金鑰（設定後 Argus 端 AgentServiceConfig 的 key 要相符）；空＝不驗證（僅限內網）
ARGUS_AGENT_SERVICE_KEY=

# LLM 金鑰（至少一個；自家多代理用 chat_with_tools，需支援 tool calling 的模型）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
GLM_API_KEY=
GOOGLE_API_KEY=

# 暫存（服務用完即刪 scan 列；單檔 SQLite，單 worker）
ARGUS_DB_PATH=/home/jie/Project/argus-agent/db.sqlite3
ARGUS_MEDIA_ROOT=/home/jie/Project/argus-agent/media

# 成本/時間主旋鈕
ARGUS_AGENT_SPECIALIST_MAX_STEPS=30
ARGUS_AGENT_MAX_SPECIALIST_DISPATCH=6
ARGUS_AGENT_MAX_TOKENS=60000
ARGUS_AGENT_UX_MAX_TOKENS=120000

# 掃描器出口 IP（逗號分隔），避免自身 IP 被誤判成內網外洩
ARGUS_SCANNER_EGRESS_IPS=
